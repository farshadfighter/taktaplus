# Copy to .env for local development (never commit .env).
TAKTAPLUS_LISTEN=:8080
# Plain HTTP for local development (vite proxies to it); production uses TLS.
TAKTAPLUS_TLS=off
TAKTAPLUS_DATABASE_URL=postgres://taktaplus:taktaplus@localhost:5432/taktaplus?sslmode=disable
TAKTAPLUS_DATA_DIR=./.data
TAKTAPLUS_LOG_LEVEL=debug
# 32 random bytes, base64 (head -c32 /dev/urandom | base64). Keep it secret.
TAKTAPLUS_MASTER_KEY=
TAKTAPLUS_COOKIE_SECURE=false
# License server for online activation (optional; offline activation always works).
TAKTAPLUS_LICENSE_SERVER=
# Built-in TFTP/FTP server for devices (address devices use to reach TaktaPlus).
TAKTAPLUS_FILESERVER_IP=
TAKTAPLUS_TFTP_LISTEN=:6969
TAKTAPLUS_FTP_LISTEN=:2121

# Copy to .env and fill in before `docker compose up`.

TAKTAPLUS_JWT_SECRET_KEY=change-me-to-a-random-64-char-string
TAKTAPLUS_DATABASE_URL=postgresql+psycopg://taktaplus:taktaplus@db:5432/taktaplus
TAKTAPLUS_REDIS_URL=redis://redis:6379/0

# Local dev only - points at dev/mock-license-server. In production this
# points at the vendor's real License Server (separate product/repo).
TAKTAPLUS_LICENSE_SERVER_URL=http://mock-license-server:8100

TAKTAPLUS_MASTER_KEY_PATH=/etc/taktaplus/master.key

# Default FTP source for offline signature/firmware distribution (see
# docs/signature-distribution.md, built in phase 4). Leave unset in dev.
TAKTAPLUS_DEFAULT_FTP_HOST=
TAKTAPLUS_DEFAULT_FTP_PORT=21
TAKTAPLUS_DEFAULT_FTP_USERNAME=
TAKTAPLUS_DEFAULT_FTP_PASSWORD=

# SNMP monitoring (phase 3, see docs/monitoring.md). Defaults are usually
# fine; override thresholds/interval here if needed.
TAKTAPLUS_SNMP_POLL_INTERVAL_MINUTES=5
TAKTAPLUS_SNMP_TRAP_LISTEN_HOST=0.0.0.0
TAKTAPLUS_SNMP_TRAP_LISTEN_PORT=162

# Alerting (phase 3) - both optional, leave unset to disable that channel.
TAKTAPLUS_ALERT_EMAIL_SMTP_HOST=
TAKTAPLUS_ALERT_EMAIL_SMTP_PORT=587
TAKTAPLUS_ALERT_EMAIL_SMTP_USERNAME=
TAKTAPLUS_ALERT_EMAIL_SMTP_PASSWORD=
TAKTAPLUS_ALERT_EMAIL_FROM=
TAKTAPLUS_ALERT_EMAIL_TO=
TAKTAPLUS_ALERT_TELEGRAM_BOT_TOKEN=
TAKTAPLUS_ALERT_TELEGRAM_CHAT_ID=

POSTGRES_USER=taktaplus
POSTGRES_PASSWORD=taktaplus
POSTGRES_DB=taktaplus
